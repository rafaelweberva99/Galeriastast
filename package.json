{
  "name": "galeriastats",
  "version": "0.1.0",
  "private": true,
  "description": "Carnet de hincha del fútbol chileno: marca los partidos a los que fuiste y descubre si eres cábala o yeta.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/copy-vendor.mjs && next dev",
    "build": "node scripts/copy-vendor.mjs && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "data:fetch": "node --experimental-strip-types --no-warnings scripts/fetch.ts",
    "data:ingest": "node --experimental-strip-types --no-warnings scripts/ingest.ts",
    "data:verify": "node --experimental-strip-types --no-warnings scripts/verify.ts",
    "demo:build": "node --experimental-strip-types --no-warnings demo/build.ts",
    "vercel-build": "npm run data:fetch && npm run data:ingest && npm run build",
    "vendor": "node scripts/copy-vendor.mjs"
  },
  "dependencies": {
    "next": "^15.5.28",
    "pdfjs-dist": "^4.10.38",
    "postgres": "^3.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tesseract.js": "^5.1.1",
    "zod": "^3.25.76",
    "@tesseract.js-data/spa": "^1.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
